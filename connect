#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")"
command -v node >/dev/null || { echo 'Install Node.js 22 or newer.' >&2; exit 1; }
node -e 'if (Number(process.versions.node.split(".")[0]) < 22) { console.error("Node.js 22 or newer is required."); process.exit(1); }'
if [[ ! -f node_modules/.world-agent-lock ]] || ! cmp -s package-lock.json node_modules/.world-agent-lock; then
  npm ci --no-fund
  cp package-lock.json node_modules/.world-agent-lock
fi
exec node src/cli.mjs "$@"
